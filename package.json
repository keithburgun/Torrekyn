{
  "name": "torrekin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run art && tsc --noEmit && vite build",
    "preview": "vite preview",
    "art": "node tools/gen-art.mjs",
    "test": "vitest run",
    "cards": "python3 tools/import_cards.py",
    "tauri": "tauri",
    "release": "node tools/release.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:artifact": "npm run art && tsc --noEmit && TORREKIN_TARGET=artifact vite build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@tauri-apps/api": "^2.12.4"
  }
}
